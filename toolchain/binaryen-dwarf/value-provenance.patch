+void IRBuilder::recordDebugInputStack(BinaryLocation pc) {
+  if (!func) {
+    return;
+  }
+  std::vector<Expression*> values;
+  for (auto& scope : scopeStack) {
+    // Block parameters, tuples and unreachable stacks need a richer identity
+    // model. Absence here means unavailable, not a guessed stack slot.
+    if (scope.unreachable || scope.inputType.isConcrete()) {
+      return;
+    }
+    for (auto* expr : scope.exprStack) {
+      if (expr->type.isTuple()) {
+        return;
+      }
+      if (expr->type.isConcrete()) {
+        values.push_back(expr);
+      }
+    }
+  }
+  func->debugInputStacks.emplace(pc, std::move(values));
+}
