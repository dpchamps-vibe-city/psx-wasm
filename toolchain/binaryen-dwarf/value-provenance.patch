+
+// Inline expressions have implicit scope-wide validity. Turn them into lists
+// before emitting transformed code: even an unchanged local/frame base must
+// not describe synthetic unwind/rewind instructions. Rebuild DIE references,
+// not just the section length, when an expression becomes a list reference.
+using AbbrevKey = std::pair<uint64_t, uint64_t>;
+
+struct DebugInfoLayout : llvm::DWARFYAML::Visitor {
+  uint64_t offset = 0, base = 0, header = 0;
+  std::vector<uint64_t> units, entries;
+  DebugInfoLayout(llvm::DWARFYAML::Data& data)
+    : llvm::DWARFYAML::Visitor(data) {
+    traverseDebugInfo();
+  }
+  void onStartCompileUnit(llvm::DWARFYAML::Unit& cu) override {
+    base = offset;
+    units.push_back(base);
+    header = cu.Length.isDWARF64() ? 12 : 4;
+    offset += header + (cu.Version >= 5 ? 8 : 7);
+  }
+  void onEndCompileUnit(llvm::DWARFYAML::Unit& cu) override {
+    cu.Length.setLength(offset - base - header);
+  }
+  void onStartDIE(llvm::DWARFYAML::Unit&,
+                  llvm::DWARFYAML::Entry& die) override {
+    entries.push_back(offset);
+    offset += llvm::getULEB128Size(die.AbbrCode);
+  }
+  void onValue(uint8_t) override { ++offset; }
+  void onValue(uint16_t) override { offset += 2; }
+  void onValue(uint32_t) override { offset += 4; }
+  void onValue(uint64_t value, bool leb = false) override {
+    offset += leb ? llvm::getULEB128Size(value) : 8;
+  }
+  void onValue(int64_t value, bool leb = false) override {
+    offset += leb ? llvm::getSLEB128Size(value) : 8;
+  }
+  void onValue(llvm::StringRef value) override { offset += value.size() + 1; }
+  void onValue(llvm::MemoryBufferRef value) override {
+    offset += value.getBufferSize();
+  }
+};
+
+static void rebuildInlineLocations(llvm::DWARFYAML::Data& data,
+                                   const BinaryenDWARFInfo& info,
+                                   ValueLocationUpdater& values,
+                                   uint64_t locOffset) {
+  std::map<AbbrevKey, llvm::DWARFYAML::Abbrev> abbrevs;
+  std::map<uint64_t, uint64_t> nextCodes;
+  for (auto& abbrev : data.AbbrevDecls) {
+    if (abbrev.Code) {
+      abbrevs[{abbrev.ListOffset, abbrev.Code}] = abbrev;
+      nextCodes[abbrev.ListOffset] =
+        std::max(nextCodes[abbrev.ListOffset], uint64_t(abbrev.Code) + 1);
+    }
+  }
+  // Original references are immutable across the layout fixed point.
+  struct Reference {
+    llvm::DWARFYAML::FormValue* value;
+    uint64_t target, unit;
+    bool absolute;
+  };
+  std::vector<Reference> refs;
+  std::vector<uint64_t> oldEntries, oldUnits;
+  size_t unitIndex = 0;
+  bool changed = false;
+  auto append = [&](llvm::DWARFYAML::Loc loc) {
+    locOffset += 8;
+    if (loc.Start != uint32_t(-1) && (loc.Start || loc.End)) {
+      locOffset += 2 + loc.Location.size();
+    }
+    data.Locs.push_back(std::move(loc));
+  };
+  for (auto& cu : info.context->compile_units()) {
+    auto& unit = data.CompileUnits[unitIndex++];
+    oldUnits.push_back(cu->getOffset());
+    struct Scope {
+      FunctionValueLocations* function = nullptr;
+      std::vector<BinaryLocations::Span> ranges;
+    };
+    std::vector<Scope> parents;
+    size_t entryIndex = 0;
+    for (auto& die : cu->dies()) {
+      auto& entry = unit.Entries[entryIndex++];
+      oldEntries.push_back(die.getOffset());
+      if (!entry.AbbrCode) {
+        continue;
+      }
+      auto depth = die.getDepth();
+      if (parents.size() > depth) {
+        parents.resize(depth);
+      }
+      Scope scope = parents.empty() ? Scope{} : parents.back();
+      auto dwarfDie = llvm::DWARFDie(cu.get(), &die);
+      auto ranges = dwarfDie.getAddressRanges();
+      if (!ranges) {
+        llvm::consumeError(ranges.takeError());
+        scope.ranges.clear();
+      } else if (!ranges->empty()) {
+        scope.ranges.clear();
+        for (auto range : *ranges) {
+          if (range.LowPC < range.HighPC && range.HighPC <= UINT32_MAX) {
+            scope.ranges.push_back(
+              {uint32_t(range.LowPC), uint32_t(range.HighPC)});
+          }
+        }
+      }
+      if (die.getTag() == llvm::dwarf::DW_TAG_subprogram &&
+          dwarfDie.find(llvm::dwarf::DW_AT_low_pc)) {
+        scope.function = scope.ranges.empty()
+                           ? nullptr
+                           : values.find(scope.ranges.front().start);
+      }
+      parents.push_back(scope);
+      auto original = abbrevs.at({unit.AbbrOffset, entry.AbbrCode});
+      auto replacement = original;
+      bool replaced = false;
+      for (size_t i = 0; i < original.Attributes.size(); ++i) {
+        auto attr = original.Attributes[i];
+        auto& value = entry.Values[i];
+        switch (attr.Form) {
+          case llvm::dwarf::DW_FORM_ref1:
+          case llvm::dwarf::DW_FORM_ref2:
+          case llvm::dwarf::DW_FORM_ref4:
+          case llvm::dwarf::DW_FORM_ref8:
+          case llvm::dwarf::DW_FORM_ref_udata:
+            refs.push_back(
+              {&value, value.Value + cu->getOffset(), cu->getOffset(), false});
+            break;
+          case llvm::dwarf::DW_FORM_ref_addr:
+            refs.push_back({&value, value.Value, cu->getOffset(), true});
+            break;
+          default:
+            break;
+        }
+        if (!scope.function || !isLocationListAttribute(attr.Attribute) ||
+            attr.Form != llvm::dwarf::DW_FORM_exprloc) {
+          continue;
+        }
+        if (unit.Version != 4 || unit.AddrSize != 4 ||
+            unit.Length.isDWARF64()) {
+          Fatal() << "Flatten value repair requires wasm32 DWARF 4";
+        }
+        std::vector<uint8_t> bytes(value.BlockData.begin(),
+                                   value.BlockData.end());
+        std::vector<ValueLocationOp> ops;
+        // LLDB's wasm register-backed frame base is consumed directly from
+        // exprloc; its generic location-list frame-base evaluator does not
+        // implement DW_OP_WASM_location. Keep this original-local identity.
+        // All dependent variable expressions are still split into proven
+        // normal-only opcode intervals, so no synthetic PC exposes a value.
+        if (attr.Attribute == llvm::dwarf::DW_AT_frame_base &&
+            decodeValueLocation(bytes, ops) && ops.size() == 2 && ops[0].wasm &&
+            ((ops[0].kind == 0 &&
+              ops[0].index < scope.function->func->getNumLocals()) ||
+             (ops[0].kind == 1 &&
+              ops[0].index < values.updater.wasm.globals.size())) &&
+            bytes[ops[1].begin] == llvm::dwarf::DW_OP_stack_value) {
+          continue;
+        }
+        auto start = locOffset;
+        append({uint32_t(-1), 0, {}, 0});
+        for (auto range : scope.ranges) {
+          auto locations = values.relocate(
+            {range.start, range.end, bytes, 0}, range.start, range.end);
+          for (auto& loc : locations) {
+            append(std::move(loc));
+          }
+        }
+        append({0, 0, {}, 0});
+        value.BlockData.clear();
+        value.Value = start;
+        replacement.Attributes[i].Form = llvm::dwarf::DW_FORM_sec_offset;
+        replaced = changed = true;
+      }
+      if (replaced) {
+        // Reuse identical replacement shapes within this abbreviation table.
+        auto begin = abbrevs.lower_bound({unit.AbbrOffset, 0});
+        auto end = abbrevs.upper_bound({unit.AbbrOffset, UINT64_MAX});
+        auto found = std::find_if(begin, end, [&](auto& item) {
+          auto& a = item.second;
+          if (a.ListOffset != replacement.ListOffset ||
+              a.Tag != replacement.Tag || a.Children != replacement.Children ||
+              a.Attributes.size() != replacement.Attributes.size()) {
+            return false;
+          }
+          for (size_t i = 0; i < a.Attributes.size(); ++i) {
+            if (a.Attributes[i].Attribute !=
+                  replacement.Attributes[i].Attribute ||
+                a.Attributes[i].Form != replacement.Attributes[i].Form ||
+                a.Attributes[i].Value != replacement.Attributes[i].Value) {
+              return false;
+            }
+          }
+          return true;
+        });
+        if (found == end) {
+          replacement.Code = nextCodes[unit.AbbrOffset]++;
+          entry.AbbrCode = replacement.Code;
+          abbrevs[{unit.AbbrOffset, replacement.Code}] = std::move(replacement);
+        } else {
+          entry.AbbrCode = found->second.Code;
+        }
+      }
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  // Rebuild abbreviation tables and their CU offsets too.
+  data.AbbrevDecls.clear();
+  std::map<uint64_t, uint64_t> abbrevOffsets;
+  uint64_t offset = 0, current = UINT64_MAX;
+  for (auto& [key, abbrev] : abbrevs) {
+    if (key.first != current) {
+      if (current != UINT64_MAX) {
+        data.AbbrevDecls.push_back({0, {}, {}, {}, abbrevOffsets.at(current)});
+        ++offset;
+      }
+      current = key.first;
+      abbrevOffsets[current] = offset;
+    }
+    abbrev.ListOffset = abbrevOffsets.at(current);
+    offset +=
+      llvm::getULEB128Size(abbrev.Code) + llvm::getULEB128Size(abbrev.Tag) + 1;
+    for (auto attr : abbrev.Attributes) {
+      offset +=
+        llvm::getULEB128Size(attr.Attribute) + llvm::getULEB128Size(attr.Form);
+      if (attr.Form == llvm::dwarf::DW_FORM_implicit_const) {
+        offset += llvm::getSLEB128Size(attr.Value);
+      }
+    }
+    offset += 2;
+    data.AbbrevDecls.push_back(abbrev);
+  }
+  data.AbbrevDecls.push_back({0, {}, {}, {}, abbrevOffsets.at(current)});
+  for (auto& unit : data.CompileUnits) {
+    unit.AbbrOffset = abbrevOffsets.at(unit.AbbrOffset);
+  }
+  // Fixed-width references converge immediately; ref_udata may change size.
+  // Always map from the ORIGINAL target, never from a previous iteration.
+  for (unsigned iteration = 0; iteration < 32; ++iteration) {
+    DebugInfoLayout layout(data);
+    std::unordered_map<uint64_t, uint64_t> entries, units;
+    for (size_t i = 0; i < oldEntries.size(); ++i) {
+      entries[oldEntries[i]] = layout.entries[i];
+    }
+    for (size_t i = 0; i < oldUnits.size(); ++i) {
+      units[oldUnits[i]] = layout.units[i];
+    }
+    bool stable = true;
+    for (auto& ref : refs) {
+      if (!entries.contains(ref.target)) {
+        Fatal() << "Unmapped DWARF DIE reference";
+      }
+      auto target =
+        entries.at(ref.target) - (ref.absolute ? 0 : units.at(ref.unit));
+      stable &= ref.value->Value == target;
+      ref.value->Value = target;
+    }
+    if (stable) {
+      for (auto& arange : data.ARanges) {
+        arange.CuOffset = units.at(arange.CuOffset);
+      }
+      return;
+    }
+  }
+  Fatal() << "DWARF DIE layout did not converge";
+}
