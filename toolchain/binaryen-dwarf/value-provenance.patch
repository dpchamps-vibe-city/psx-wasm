+
+// PSXW Binaryen 133 candidate repair. Included by wasm-debug.cpp after
+// LocationUpdater. No executable instructions are added by this analysis.
+
+// Decode whole expressions. In particular, WASM indices are ULEBs, not bytes.
+// Keep unknown expressions unavailable rather than retaining a stale location.
+struct ValueLocationOp {
+  size_t begin, end;
+  bool wasm = false;
+  uint32_t kind = 0, index = 0;
+};
+
+static bool readLocationULEB(const std::vector<uint8_t>& bytes,
+                             size_t& at,
+                             uint32_t& value) {
+  value = 0;
+  for (unsigned shift = 0; shift < 35; shift += 7) {
+    if (at == bytes.size()) {
+      return false;
+    }
+    auto byte = bytes[at++];
+    if (shift == 28 && (byte & 0xf0)) {
+      return false;
+    }
+    value |= uint32_t(byte & 0x7f) << shift;
+    if (!(byte & 0x80)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static void writeLocationULEB(std::vector<uint8_t>& bytes, uint32_t value) {
+  do {
+    auto byte = uint8_t(value & 0x7f);
+    value >>= 7;
+    bytes.push_back(byte | (value ? 0x80 : 0));
+  } while (value);
+}
+
+static bool decodeValueLocation(const std::vector<uint8_t>& bytes,
+                                std::vector<ValueLocationOp>& ops) {
+  llvm::StringRef data(reinterpret_cast<const char*>(bytes.data()),
+                       bytes.size());
+  llvm::DWARFExpression expr(llvm::DataExtractor(data, true, 4), 4, 4);
+  size_t begin = 0;
+  for (auto op : expr) {
+    if (op.isError() || op.getEndOffset() > bytes.size() ||
+        op.getEndOffset() <= begin) {
+      return false;
+    }
+    // Relative expression branches need their own displacement relocation.
+    // Nested entry values need provenance at entry, not the current PC.
+    if (op.getCode() == llvm::dwarf::DW_OP_bra ||
+        op.getCode() == llvm::dwarf::DW_OP_skip ||
+        op.getCode() == llvm::dwarf::DW_OP_entry_value ||
+        op.getCode() == llvm::dwarf::DW_OP_GNU_entry_value) {
+      return false;
+    }
+    ValueLocationOp result{begin, size_t(op.getEndOffset())};
+    if (op.getCode() == llvm::dwarf::DW_OP_WASM_location) {
+      result.wasm = true;
+      size_t at = begin + 1;
+      if (!readLocationULEB(bytes, at, result.kind) || result.kind > 2 ||
+          !readLocationULEB(bytes, at, result.index) || at != result.end) {
+        return false;
+      }
+    }
+    ops.push_back(result);
+    begin = result.end;
+  }
+  return begin == bytes.size();
+}
+
+static bool hasStackLocation(const std::vector<ValueLocationOp>& ops) {
+  return std::any_of(ops.begin(), ops.end(), [](const auto& op) {
+    return op.wasm && op.kind == 2;
+  });
+}
+
+static bool isLocationListAttribute(llvm::dwarf::Attribute attr) {
+  switch (attr) {
+    case llvm::dwarf::DW_AT_location:
+    case llvm::dwarf::DW_AT_string_length:
+    case llvm::dwarf::DW_AT_return_addr:
+    case llvm::dwarf::DW_AT_data_member_location:
+    case llvm::dwarf::DW_AT_frame_base:
+    case llvm::dwarf::DW_AT_segment:
+    case llvm::dwarf::DW_AT_static_link:
+    case llvm::dwarf::DW_AT_use_location:
+    case llvm::dwarf::DW_AT_vtable_elem_location:
+      return true;
+    default:
+      return false;
+  }
+}
+
+std::vector<BinaryLocations::Span> stackLocationRanges(const Module& wasm) {
+  BinaryenDWARFInfo info(wasm);
+  llvm::DWARFYAML::Data data;
+  if (dwarf2yaml(*info.context, data)) {
+    Fatal() << "Failed to parse input DWARF for value provenance";
+  }
+  std::unordered_map<uint64_t, uint32_t> bases;
+  std::vector<BinaryLocations::Span> ranges;
+  for (auto& cu : info.context->compile_units()) {
+    auto baseAttr = cu->getUnitDIE().find(llvm::dwarf::DW_AT_low_pc);
+    uint32_t base = baseAttr ? baseAttr->getAsAddress().getValueOr(0) : 0;
+    for (auto& die : cu->dies()) {
+      auto* abbrev = die.getAbbreviationDeclarationPtr();
+      if (!abbrev) {
+        continue;
+      }
+      for (auto& attr : abbrev->attributes()) {
+        if (!isLocationListAttribute(attr.Attr)) {
+          continue;
+        }
+        auto location = llvm::DWARFDie(cu.get(), &die).find(attr.Attr);
+        if (location) {
+          if (auto offset = location->getAsSectionOffset()) {
+            bases[*offset] = base;
+          } else if (auto block = location->getAsBlock()) {
+            std::vector<uint8_t> bytes(block->begin(), block->end());
+            std::vector<ValueLocationOp> ops;
+            if (decodeValueLocation(bytes, ops) && hasStackLocation(ops)) {
+              for (auto scope = llvm::DWARFDie(cu.get(), &die); scope;
+                   scope = scope.getParent()) {
+                auto addresses = scope.getAddressRanges();
+                if (!addresses) {
+                  llvm::consumeError(addresses.takeError());
+                  break;
+                }
+                if (addresses->empty()) {
+                  continue;
+                }
+                for (auto range : *addresses) {
+                  if (range.LowPC < range.HighPC &&
+                      range.HighPC <= UINT32_MAX) {
+                    ranges.push_back(
+                      {uint32_t(range.LowPC), uint32_t(range.HighPC)});
+                  }
+                }
+                break;
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  uint32_t base = 0;
+  bool atStart = true;
+  for (auto& loc : data.Locs) {
+    if (atStart) {
+      base = bases[loc.CompileUnitOffset];
+      atStart = false;
+    }
+    if (loc.Start == uint32_t(-1)) {
+      base = loc.End;
+    } else if (loc.Start == 0 && loc.End == 0) {
+      atStart = true;
+    } else {
+      std::vector<ValueLocationOp> ops;
+      if (decodeValueLocation(loc.Location, ops) && hasStackLocation(ops) &&
+          uint64_t(loc.End) + base <= uint32_t(-1) && loc.Start < loc.End) {
+        ranges.push_back({loc.Start + base, loc.End + base});
+      }
+    }
+  }
+  std::sort(ranges.begin(), ranges.end(), [](auto a, auto b) {
+    return a.start < b.start;
+  });
+  std::vector<BinaryLocations::Span> merged;
+  for (auto range : ranges) {
+    if (!merged.empty() && range.start <= merged.back().end) {
+      merged.back().end = std::max(merged.back().end, range.end);
+    } else {
+      merged.push_back(range);
+    }
+  }
+  return merged;
+}
+
+// A forward must-definition analysis on the actual output CFG. A lexical
+// assignment-before-PC test is unsound at joins, on backedges and on rewind
+// paths. A fact is a local definitely holding what the DWARF expects:
+// - A spill local holds its recorded producer. Only that assignment
+//   establishes it; any other write, including an Asyncify restore, kills it.
+// - Any other local holds the original program's value. Every write
+//   establishes it: original code, or a restore of the value saved at the
+//   unwind. On rewind entry no local holds it. Asyncify restores only the
+//   locals live at a call, so a dead local stays invalid after a resume
+//   (its zero-initialized value is not the program's).
+// One bit per local: lifted functions have thousands of Flatten spills, and
+// every block holds three states.
+struct ValueFacts {
+  Index size = 0;
+  std::vector<uint64_t> words;
+  ValueFacts() = default;
+  ValueFacts(Index size, bool all)
+    : size(size), words((size + 63) / 64, all ? ~uint64_t(0) : 0) {}
+  bool contains(Index i) const {
+    return i < size && (words[i / 64] >> (i % 64) & 1);
+  }
+  void insert(Index i) { words[i / 64] |= uint64_t(1) << (i % 64); }
+  void erase(Index i) { words[i / 64] &= ~(uint64_t(1) << (i % 64)); }
+  void intersect(const ValueFacts& other) {
+    for (size_t i = 0; i < words.size(); ++i) {
+      words[i] &= other.words[i];
+    }
+  }
+  bool operator==(const ValueFacts& other) const = default;
+};
+using ValueStates = std::array<std::optional<ValueFacts>, 3>;
+
+struct ValueFlowBlock {
+  std::vector<Expression*> actions;
+  ValueStates in, out;
+};
+
+struct ValueFlow
+  : CFGWalker<ValueFlow, UnifiedExpressionVisitor<ValueFlow>, ValueFlowBlock> {
+  using Base =
+    CFGWalker<ValueFlow, UnifiedExpressionVisitor<ValueFlow>, ValueFlowBlock>;
+  bool ignoreBranchesOutsideOfFunc = true;
+  bool asyncify;
+  std::map<std::pair<BasicBlock*, BasicBlock*>, std::pair<Expression*, bool>>
+    conditions;
+  std::unordered_set<Expression*> definitions;
+  ValueFacts spills;
+  std::unordered_set<Expression*> queries;
+  std::unordered_map<Expression*, ValueFacts> available;
+  std::unordered_set<Expression*> normalOnly;
+
+  void visitExpression(Expression* expr) {
+    if (currBasicBlock && (expr->is<LocalSet>() || expr->is<GlobalSet>() ||
+                           expr->is<Call>() || expr->is<CallIndirect>() ||
+                           expr->is<CallRef>() || queries.contains(expr))) {
+      currBasicBlock->contents.actions.push_back(expr);
+    }
+  }
+
+  void transfer(Expression* expr, ValueFacts& state) {
+    if (auto* set = expr->dynCast<LocalSet>()) {
+      if (!spills.contains(set->index) || definitions.contains(expr)) {
+        state.insert(set->index);
+      } else {
+        state.erase(set->index);
+      }
+    }
+  }
+
+  static void doStartIfTrue(ValueFlow* self, Expression** currp) {
+    auto* from = self->currBasicBlock;
+    Base::doStartIfTrue(self, currp);
+    self->conditions[{from, self->currBasicBlock}] = {
+      (*currp)->cast<If>()->condition, true};
+  }
+
+  static void doStartIfFalse(ValueFlow* self, Expression** currp) {
+    auto* from = self->ifLastBlockStack.back();
+    Base::doStartIfFalse(self, currp);
+    self->conditions[{from, self->currBasicBlock}] = {
+      (*currp)->cast<If>()->condition, false};
+  }
+
+  static void doEndIf(ValueFlow* self, Expression** currp) {
+    auto* from = self->ifLastBlockStack.back();
+    Base::doEndIf(self, currp);
+    if (!(*currp)->cast<If>()->ifFalse) {
+      self->conditions[{from, self->currBasicBlock}] = {
+        (*currp)->cast<If>()->condition, false};
+    }
+  }
+
+  std::optional<int32_t> evaluate(Expression* expr, int32_t state) {
+    if (auto* get = expr->dynCast<GlobalGet>()) {
+      if (asyncify && get->name == Name("__asyncify_state")) {
+        return state;
+      }
+    } else if (auto* c = expr->dynCast<Const>()) {
+      if (c->type == Type::i32) {
+        return c->value.geti32();
+      }
+    } else if (auto* binary = expr->dynCast<Binary>()) {
+      auto left = evaluate(binary->left, state),
+           right = evaluate(binary->right, state);
+      switch (binary->op) {
+        case EqInt32:
+          if (left && right) {
+            return *left == *right;
+          }
+          break;
+        case NeInt32:
+          if (left && right) {
+            return *left != *right;
+          }
+          break;
+        case OrInt32:
+          if (left && right) {
+            return *left | *right;
+          }
+          break;
+        case AndInt32:
+          if ((left && !*left) || (right && !*right)) {
+            return 0;
+          }
+          if (left && right) {
+            return *left & *right;
+          }
+          break;
+        default:
+          break;
+      }
+    }
+    return std::nullopt;
+  }
+
+  std::optional<bool> evaluateCondition(Expression* expr, int32_t state) {
+    if (auto* binary = expr->dynCast<Binary>();
+        binary && binary->op == OrInt32) {
+      auto left = evaluateCondition(binary->left, state);
+      auto right = evaluateCondition(binary->right, state);
+      if ((left && *left) || (right && *right)) {
+        return true;
+      }
+      if (left && right) {
+        return false;
+      }
+      return std::nullopt;
+    }
+    auto value = evaluate(expr, state);
+    return value ? std::optional<bool>(bool(*value)) : std::nullopt;
+  }
+
+  static void merge(std::optional<ValueFacts>& dest, const ValueFacts& from) {
+    if (!dest) {
+      dest = from;
+    } else {
+      dest->intersect(from);
+    }
+  }
+
+  void transferStates(Expression* expr, ValueStates& states) {
+    for (auto& state : states) {
+      if (state) {
+        transfer(expr, *state);
+      }
+    }
+    bool mayChangeState = true;
+    if (auto* call = expr->dynCast<Call>()) {
+      if (auto* target = getModule()->getFunctionOrNull(call->target)) {
+        mayChangeState = target->debugCanChangeAsyncifyState.value_or(true);
+      }
+    }
+    if (asyncify && mayChangeState &&
+        (expr->is<Call>() || expr->is<CallIndirect>() || expr->is<CallRef>())) {
+      // A callee may start unwinding or finish rewinding. No local changes,
+      // and no assumed correlation with a particular pending call site.
+      std::optional<ValueFacts> facts;
+      for (auto& state : states) {
+        if (state) {
+          merge(facts, *state);
+        }
+      }
+      states = {facts, facts, facts};
+    }
+    if (asyncify) {
+      if (auto* set = expr->dynCast<GlobalSet>();
+          set && set->name == Name("__asyncify_state")) {
+        ValueStates result;
+        for (size_t i = 0; i < 3; ++i) {
+          if (!states[i]) {
+            continue;
+          }
+          auto value = evaluate(set->value, i);
+          for (size_t j = 0; j < 3; ++j) {
+            if (!value || *value == int32_t(j)) {
+              merge(result[j], *states[i]);
+            }
+          }
+        }
+        states = std::move(result);
+      }
+    }
+  }
+
+  ValueFlow(Function* func, Module& module)
+    : asyncify(module.getGlobalOrNull(Name("__asyncify_state")) != nullptr) {
+    auto locals = func->getNumLocals();
+    ValueFacts universe(locals, true), normalEntry(locals, true);
+    spills = ValueFacts(locals, false);
+    for (auto& [producer, spill] : func->debugValueSpills) {
+      definitions.insert(spill.assignment);
+      spills.insert(spill.local);
+      normalEntry.erase(spill.local);
+    }
+    for (auto& [expr, span] : func->expressionLocations) {
+      // Control-flow structure locations refer to a different traversal
+      // position than a postorder action. Do not claim availability there.
+      if (!Properties::isControlFlowStructure(expr)) {
+        queries.insert(expr);
+      }
+    }
+    setFunction(func);
+    setModule(&module);
+    doWalkFunction(func);
+    auto live = findLiveBlocks();
+    unlinkDeadBlocks(live);
+    for (auto& block : basicBlocks) {
+      if (live.contains(block.get())) {
+        block->contents.in = {universe, universe, universe};
+        block->contents.out = {universe, universe, universe};
+      }
+    }
+    bool changed;
+    do {
+      changed = false;
+      for (auto& block : basicBlocks) {
+        if (!live.contains(block.get())) {
+          continue;
+        }
+        ValueStates state;
+        if (block.get() == entry) {
+          // Normal entry: parameters hold the arguments and variables the
+          // zeros the original program also starts with.
+          state[0] = normalEntry;
+          if (asyncify) {
+            state[1] = state[2] = ValueFacts(locals, false);
+          }
+        } else {
+          for (auto* from : block->in) {
+            auto condition = conditions.find({from, block.get()});
+            for (size_t i = 0; i < 3; ++i) {
+              if (!from->contents.out[i]) {
+                continue;
+              }
+              if (condition != conditions.end()) {
+                auto test = evaluateCondition(condition->second.first, i);
+                if (test && bool(*test) != condition->second.second) {
+                  continue;
+                }
+              }
+              merge(state[i], *from->contents.out[i]);
+            }
+          }
+        }
+        block->contents.in = state;
+        for (auto* action : block->contents.actions) {
+          transferStates(action, state);
+        }
+        if (state != block->contents.out) {
+          block->contents.out = std::move(state);
+          changed = true;
+        }
+      }
+    } while (changed);
+    for (auto& block : basicBlocks) {
+      if (!live.contains(block.get())) {
+        continue;
+      }
+      auto state = block->contents.in;
+      for (auto* action : block->contents.actions) {
+        if (queries.contains(action)) {
+          if (state[0] && !state[1] && !state[2]) {
+            normalOnly.insert(action);
+          }
+          // A PC can also execute during rewind. Only describe facts true
+          // in every state reaching it, not merely in normal execution.
+          std::optional<ValueFacts> facts;
+          for (auto& mode : state) {
+            if (mode) {
+              merge(facts, *mode);
+            }
+          }
+          if (facts) {
+            available.emplace(action, *facts);
+          }
+        }
+        transferStates(action, state);
+      }
+    }
+    // Keep only the answers; the CFG's per-block states are not needed.
+    basicBlocks.clear();
+    conditions.clear();
+  }
+};
+
+struct ValueLocationPoint {
+  Expression* expr;
+  BinaryLocations::Span input, output;
+};
+
+struct FunctionValueLocations {
+  Function* func;
+  std::vector<ValueLocationPoint> points;
+  std::unique_ptr<ValueFlow> flow;
+  // DW_AT_frame_base. A frame-relative location also needs a local frame
+  // base to hold its value; an unknown one makes it unavailable.
+  enum class FrameBase { Unknown, Global, Local } frameBase = FrameBase::Unknown;
+  Index frameBaseLocal = 0;
+};
+
+// Indexed once per function, not a scan of the game for each variable entry.
+struct ValueLocationUpdater {
+  const LocationUpdater& updater;
+  std::vector<FunctionValueLocations> functions;
+
+  ValueLocationUpdater(const LocationUpdater& updater,
+                       const BinaryenDWARFInfo& info)
+    : updater(updater) {
+    for (auto& func : updater.wasm.functions) {
+      if (func->imported() || !func->debugValuesFlattened) {
+        continue;
+      }
+      FunctionValueLocations locations{func.get(), {}, nullptr};
+      for (auto& [expr, input] : func->expressionLocations) {
+        auto output = updater.newLocations.expressions.find(expr);
+        if (output != updater.newLocations.expressions.end() &&
+            !Properties::isControlFlowStructure(expr) &&
+            output->second.start < output->second.end) {
+          locations.points.push_back({expr, input, output->second});
+        }
+      }
+      std::sort(locations.points.begin(),
+                locations.points.end(),
+                [](const auto& a, const auto& b) {
+                  return a.input.start < b.input.start;
+                });
+      functions.push_back(std::move(locations));
+    }
+    std::sort(
+      functions.begin(), functions.end(), [](const auto& a, const auto& b) {
+        return a.func->funcLocation.declarations <
+               b.func->funcLocation.declarations;
+      });
+    for (auto& cu : info.context->compile_units()) {
+      for (auto& entry : cu->dies()) {
+        llvm::DWARFDie die(cu.get(), &entry);
+        if (die.getTag() != llvm::dwarf::DW_TAG_subprogram) {
+          continue;
+        }
+        auto low = die.find(llvm::dwarf::DW_AT_low_pc);
+        auto base = die.find(llvm::dwarf::DW_AT_frame_base);
+        if (!low || !base) {
+          continue;
+        }
+        auto pc = low->getAsAddress();
+        auto block = base->getAsBlock();
+        if (!pc || !block || *pc > UINT32_MAX) {
+          continue;
+        }
+        auto* f = find(uint32_t(*pc));
+        std::vector<uint8_t> bytes(block->begin(), block->end());
+        std::vector<ValueLocationOp> ops;
+        if (!f || !decodeValueLocation(bytes, ops) || ops.size() != 2 ||
+            !ops[0].wasm || bytes[ops[1].begin] != llvm::dwarf::DW_OP_stack_value) {
+          continue;
+        }
+        if (ops[0].kind == 0) {
+          f->frameBase = FunctionValueLocations::FrameBase::Local;
+          f->frameBaseLocal = ops[0].index;
+        } else if (ops[0].kind == 1) {
+          f->frameBase = FunctionValueLocations::FrameBase::Global;
+        }
+      }
+    }
+  }
+
+  FunctionValueLocations* find(uint32_t pc) {
+    auto it = std::upper_bound(
+      functions.begin(), functions.end(), pc, [](uint32_t pc, const auto& f) {
+        return pc < f.func->funcLocation.declarations;
+      });
+    if (it == functions.begin()) {
+      return nullptr;
+    }
+    --it;
+    return pc < it->func->funcLocation.end ? &*it : nullptr;
+  }
+
+  bool rewrite(FunctionValueLocations& f,
+               const ValueLocationPoint& point,
+               const std::vector<uint8_t>& bytes,
+               const std::vector<ValueLocationOp>& ops,
+               std::vector<uint8_t>& output) {
+    if (!f.flow) {
+      f.flow = std::make_unique<ValueFlow>(f.func, updater.wasm);
+    }
+    // A static location cannot distinguish normal execution from a rewind
+    // visit to the same opcode before the saved locals have been restored.
+    auto state = f.flow->available.find(point.expr);
+    if (!f.flow->normalOnly.contains(point.expr) ||
+        state == f.flow->available.end()) {
+      return false;
+    }
+    auto& facts = state->second;
+    for (auto op : ops) {
+      // Locals, including the frame base under DW_OP_fbreg, must still hold
+      // the program's value here: not after a resume that left them dead.
+      if (bytes[op.begin] == llvm::dwarf::DW_OP_fbreg &&
+          (f.frameBase == FunctionValueLocations::FrameBase::Unknown ||
+           (f.frameBase == FunctionValueLocations::FrameBase::Local &&
+            !facts.contains(f.frameBaseLocal)))) {
+        return false;
+      }
+      if (op.wasm && op.kind == 0 && !facts.contains(op.index)) {
+        return false;
+      }
+      if (!op.wasm || op.kind != 2) {
+        output.insert(
+          output.end(), bytes.begin() + op.begin, bytes.begin() + op.end);
+        continue;
+      }
+      auto stack = f.func->debugInputStacks.find(point.input.start);
+      if (stack == f.func->debugInputStacks.end() ||
+          op.index >= stack->second.size()) {
+        return false;
+      }
+      auto spill = f.func->debugValueSpills.find(stack->second[op.index]);
+      if (spill == f.func->debugValueSpills.end() ||
+          !facts.contains(spill->second.local)) {
+        return false;
+      }
+      output.push_back(llvm::dwarf::DW_OP_WASM_location);
+      writeLocationULEB(output, 0);
+      writeLocationULEB(output, spill->second.local);
+    }
+    return output.size() <= UINT16_MAX;
+  }
+
+  std::vector<llvm::DWARFYAML::Loc>
+  relocate(const llvm::DWARFYAML::Loc& loc, uint32_t begin, uint32_t end) {
+    std::vector<llvm::DWARFYAML::Loc> result;
+    auto* f = find(begin);
+    if (!f) {
+      auto b = updater.getNewStart(begin), e = updater.getNewEnd(end);
+      if (b && e > b) {
+        result.push_back({b, e, loc.Location, 0});
+      }
+      return result;
+    }
+    std::vector<ValueLocationOp> ops;
+    if (!decodeValueLocation(loc.Location, ops)) {
+      return result;
+    }
+    auto point = std::lower_bound(
+      f->points.begin(),
+      f->points.end(),
+      begin,
+      [](const auto& point, uint32_t pc) { return point.input.start < pc; });
+    for (; point != f->points.end() && point->input.start < end; ++point) {
+      std::vector<uint8_t> expression;
+      if (rewrite(*f, *point, loc.Location, ops, expression)) {
+        result.push_back(
+          {point->output.start, point->output.end, std::move(expression), 0});
+      }
+    }
+    std::sort(result.begin(), result.end(), [](const auto& a, const auto& b) {
+      return std::tie(a.Start, a.End) < std::tie(b.Start, b.End);
+    });
+    return result;
+  }
+};
