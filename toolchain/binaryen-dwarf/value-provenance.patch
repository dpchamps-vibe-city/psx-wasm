+      base = updater.getCompileUnitBasesForLoc(loc.CompileUnitOffset).first;
+      append({uint32_t(-1), 0, {}, 0});
+      atStart = false;
+    }
+    if (loc.Start == uint32_t(-1)) {
+      base = loc.End;
+    } else if (loc.Start == 0 && loc.End == 0) {
