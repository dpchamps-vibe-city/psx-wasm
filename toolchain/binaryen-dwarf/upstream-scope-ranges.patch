+          writeUnavailableDIE(info, yaml, emptyRangeListOffset);
+        } else if (info.abbrevDecl && info.rangeListDirty) {
+          writeRangeList(info, yaml);
+        }
+      }
+      ++compileUnitIndex;
+    });
