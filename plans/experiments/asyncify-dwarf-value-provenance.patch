+// Research-only proof of producer identity through Flatten. Deliberately
+// limited to same-size single-value expressions; not a complete repair.
+static void repairFlattenedStackLoc(llvm::DWARFYAML::Loc& loc,
+                                    const LocationUpdater& updater,
+                                    BinaryLocation oldPC,
+                                    BinaryLocation newPC) {
+  auto& bytes = loc.Location;
+  if (bytes.size() != 4 || bytes[0] != 0xed || bytes[1] != 2 ||
+      bytes[2] >= 128 || bytes[3] != 0x9f || !newPC) { return; }
+  for (auto& f : updater.wasm.functions) {
+    if (oldPC < f->funcLocation.declarations || oldPC >= f->funcLocation.end) { continue; }
+    auto input = f->debugInputStacks.find(oldPC);
+    if (input == f->debugInputStacks.end() || bytes[2] >= input->second.size()) { return; }
+    auto spill = f->debugValueSpills.find(input->second[bytes[2]]);
+    if (spill == f->debugValueSpills.end() || spill->second.first >= 128) { return; }
+    auto position = updater.newLocations.expressions.find(spill->second.second);
+    // A lexical-order check is only sufficient for the straight-line probe.
+    // A production fix needs CFG validity, interval splitting and synthetic gaps.
+    if (position == updater.newLocations.expressions.end() || newPC < position->second.end) { return; }
+    std::cerr << "research: " << f->name << " input PC " << oldPC
+              << " stack " << unsigned(bytes[2]) << " -> local "
+              << spill->second.first << " at output PC " << newPC << '\n';
+    bytes[1] = 0;
+    bytes[2] = spill->second.first;
+    return;
+  }
+}
